SELECT * FROM clientes;
SELECT nombre, precio FROM productos;
SELECT * FROM productos WHERE precio > 100;
SELECT * FROM productos WHERE categoria = 'Electrónica' AND stock > 5;
SELECT * FROM clientes WHERE nombre LIKE 'J%';
SELECT * FROM productos ORDER BY precio DESC;
SELECT * FROM productos ORDER BY precio DESC LIMIT 2;


SELECT COUNT(*) AS total_clientes FROM clientes;
SELECT SUM(total) AS ingresos_totales FROM pedidos;
SELECT AVG(precio) AS precio_promedio FROM productos;
SELECT MAX(precio) AS mas_caro, MIN(precio) AS mas_barato FROM productos;
SELECT categoria, COUNT(*) AS cantidad, AVG(precio) AS promedio
FROM productos
GROUP BY categoria;


SELECT p.id_pedido, c.nombre, c.apellido, p.total, p.fecha_pedido
FROM pedidos p
INNER JOIN clientes c ON p.id_cliente = c.id_cliente;

SELECT c.nombre, c.apellido, p.id_pedido, p.total
FROM clientes c
LEFT JOIN pedidos p ON c.id_cliente = p.id_cliente;

SELECT c.nombre, c.apellido, SUM(p.total) AS total_gastado
FROM clientes c
INNER JOIN pedidos p ON c.id_cliente = p.id_cliente
GROUP BY c.id_cliente, c.nombre, c.apellido
ORDER BY total_gastado DESC;



