        // AGREGAR PRODUCTO
        private void AgregarProducto(object sender, EventArgs e)
        {
            if (!rolUsuario.Equals(
    "Administrador",
    StringComparison.OrdinalIgnoreCase))
            {
                MessageBox.Show(
                    "No tienes permiso para agregar productos.");
                return;
            }
            if (txtCodigo.Text.Trim() == "" ||
                txtNombre.Text.Trim() == "")
            {
                MessageBox.Show("Completa el código y el nombre.");
                return;
            }

            try
            {
                using (var conn = new SqliteConnection(conexion))
                {
                    conn.Open();

                    string sql = @"
                        INSERT INTO Productos
                        (Codigo, Nombre, Precio, Cantidad)
                        VALUES
                        ($codigo, $nombre, $precio, $cantidad);";

                    using (var cmd = new SqliteCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue(
                            "$codigo", txtCodigo.Text.Trim());

                        cmd.Parameters.AddWithValue(
                            "$nombre", txtNombre.Text.Trim());

                        cmd.Parameters.AddWithValue(
                            "$precio", numPrecio.Value);

                        cmd.Parameters.AddWithValue(
                            "$cantidad", numCantidad.Value);

                        cmd.ExecuteNonQuery();
                    }
                }

                MessageBox.Show("Producto agregado correctamente.");

                CargarProductos();
                LimpiarCampos(null, null);
            }
            catch (SqliteException ex)
            {
                MessageBox.Show(
                    "No se pudo agregar el producto.\n" + ex.Message);
            }
        }

        // MOSTRAR PRODUCTOS
        private void CargarProductos(string busqueda = "")
        {
            using (var conn = new SqliteConnection(conexion))
            {
                conn.Open();

                string sql = @"
                    SELECT Id, Codigo, Nombre, Precio, Cantidad
                    FROM Productos
                    WHERE Codigo LIKE $buscar
                    OR Nombre LIKE $buscar
                    ORDER BY Id DESC;";

                using (var cmd = new SqliteCommand(sql, conn))
                {
                    cmd.Parameters.AddWithValue(
                        "$buscar", "%" + busqueda + "%");

                    using (var reader = cmd.ExecuteReader())
                    {
                        DataTable datos = new DataTable();
                        datos.Load(reader);

                        tabla.DataSource = datos;
                    }
                }
            }
        }

        // SELECCIONAR PRODUCTO
        private void SeleccionarProducto(object sender, EventArgs e)
        {
            if (tabla.CurrentRow == null ||
                tabla.CurrentRow.IsNewRow)
                return;

            txtCodigo.Text =
                tabla.CurrentRow.Cells["Codigo"].Value.ToString();

            txtNombre.Text =
                tabla.CurrentRow.Cells["Nombre"].Value.ToString();

            numPrecio.Value = Convert.ToDecimal(
                tabla.CurrentRow.Cells["Precio"].Value);

            numCantidad.Value = Convert.ToDecimal(
                tabla.CurrentRow.Cells["Cantidad"].Value);
        }

        // MODIFICAR PRODUCTO
        private void ModificarProducto(object sender, EventArgs e)
        {
            if (!rolUsuario.Equals(
    "Administrador",
    StringComparison.OrdinalIgnoreCase))
            {
                MessageBox.Show(
                    "No tienes permiso para modificar productos.");
                return;
            }
            if (tabla.CurrentRow == null)
            {
                MessageBox.Show("Selecciona un producto.");
                return;
            }

            if (string.IsNullOrWhiteSpace(txtCodigo.Text) ||
                string.IsNullOrWhiteSpace(txtNombre.Text))
            {
                MessageBox.Show("Completa los datos.");
                return;
            }

            int id = Convert.ToInt32(
                tabla.CurrentRow.Cells["Id"].Value);

            try
            {
                using (var conn = new SqliteConnection(conexion))
                {
                    conn.Open();

                    string sql = @"
                        UPDATE Productos
                        SET Codigo = $codigo,
                            Nombre = $nombre,
                            Precio = $precio,
                            Cantidad = $cantidad
                        WHERE Id = $id;";

                    using (var cmd = new SqliteCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue(
                            "$codigo", txtCodigo.Text.Trim());

                        cmd.Parameters.AddWithValue(
                            "$nombre", txtNombre.Text.Trim());

                        cmd.Parameters.AddWithValue(
                            "$precio", numPrecio.Value);

                        cmd.Parameters.AddWithValue(
                            "$cantidad", numCantidad.Value);

                        cmd.Parameters.AddWithValue("$id", id);

                        cmd.ExecuteNonQuery();
                    }
                }

                MessageBox.Show("Producto modificado correctamente.");

                CargarProductos();
                LimpiarCampos(null, null);
            }
            catch (SqliteException ex)
            {
                MessageBox.Show(
                    "Error al modificar el producto.\n" + ex.Message);
            }
        }

        // ELIMINAR PRODUCTO
        private void EliminarProducto(object sender, EventArgs e)
        {
            if (!rolUsuario.Equals(
    "Administrador",
    StringComparison.OrdinalIgnoreCase))
            {
                MessageBox.Show(
                    "No tienes permiso para eliminar productos.");
                return;
            }
            if (tabla.CurrentRow == null)
            {
                MessageBox.Show("Selecciona un producto.");
                return;
            }

            DialogResult respuesta = MessageBox.Show(
                "¿Estás seguro de eliminar este producto?",
                "Confirmar eliminación",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Warning);

            if (respuesta != DialogResult.Yes)
                return;

            int id = Convert.ToInt32(
                tabla.CurrentRow.Cells["Id"].Value);

            using (var conn = new SqliteConnection(conexion))
            {
                conn.Open();

                string sql =
                    "DELETE FROM Productos WHERE Id = $id;";

                using (var cmd = new SqliteCommand(sql, conn))
                {
                    cmd.Parameters.AddWithValue("$id", id);
                    cmd.ExecuteNonQuery();
                }
            }

            MessageBox.Show("Producto eliminado correctamente.");

            CargarProductos();
            LimpiarCampos(null, null);
        }

        // LIMPIAR CAMPOS
        private void LimpiarCampos(object sender, EventArgs e)
        {
            txtCodigo.Clear();
            txtNombre.Clear();
            numPrecio.Value = 0;
            numCantidad.Value = 0;

            tabla.ClearSelection();
        }
    }


