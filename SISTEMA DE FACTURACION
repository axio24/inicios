                        tabla.DataSource = datos;
                    }
                }
            }
        }

        // SELECCIONAR PRODUCTO
        private void SeleccionarProducto(object sender, EventArgs e)
        {
            if (tabla.CurrentRow == null ||
                tabla.CurrentRow.IsNewRow)
                return;

            txtCodigo.Text =
                tabla.CurrentRow.Cells["Codigo"].Value.ToString();

            txtNombre.Text =
                tabla.CurrentRow.Cells["Nombre"].Value.ToString();

            numPrecio.Value = Convert.ToDecimal(
                tabla.CurrentRow.Cells["Precio"].Value);

            numCantidad.Value = Convert.ToDecimal(
                tabla.CurrentRow.Cells["Cantidad"].Value);
        }

        // MODIFICAR PRODUCTO
        private void ModificarProducto(object sender, EventArgs e)
        {
            if (!rolUsuario.Equals(
    "Administrador",
    StringComparison.OrdinalIgnoreCase))
            {
                MessageBox.Show(
                    "No tienes permiso para modificar productos.");
                return;
            }
            if (tabla.CurrentRow == null)
            {
                MessageBox.Show("Selecciona un producto.");
                return;
            }

            if (string.IsNullOrWhiteSpace(txtCodigo.Text) ||
                string.IsNullOrWhiteSpace(txtNombre.Text))
            {
                MessageBox.Show("Completa los datos.");
                return;
            }

            int id = Convert.ToInt32(
                tabla.CurrentRow.Cells["Id"].Value);

            try
            {
                using (var conn = new SqliteConnection(conexion))
                {
                    conn.Open();

                    string sql = @"
                        UPDATE Productos
                        SET Codigo = $codigo,
                            Nombre = $nombre,
                            Precio = $precio,
                            Cantidad = $cantidad
                        WHERE Id = $id;";

                    using (var cmd = new SqliteCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue(
                            "$codigo", txtCodigo.Text.Trim());

                        cmd.Parameters.AddWithValue(
                            "$nombre", txtNombre.Text.Trim());

                        cmd.Parameters.AddWithValue(
                            "$precio", numPrecio.Value);

                        cmd.Parameters.AddWithValue(
                            "$cantidad", numCantidad.Value);

                        cmd.Parameters.AddWithValue("$id", id);

                        cmd.ExecuteNonQuery();
                    }
                }

                MessageBox.Show("Producto modificado correctamente.");

                CargarProductos();
                LimpiarCampos(null, null);
            }
            catch (SqliteException ex)
            {
                MessageBox.Show(
                    "Error al modificar el producto.\n" + ex.Message);
            }
        }

        // ELIMINAR PRODUCTO
        private void EliminarProducto(object sender, EventArgs e)
        {
            if (!rolUsuario.Equals(
    "Administrador",
    StringComparison.OrdinalIgnoreCase))
            {
                MessageBox.Show(
                    "No tienes permiso para eliminar productos.");
                return;
            }
            if (tabla.CurrentRow == null)
            {
                MessageBox.Show("Selecciona un producto.");
                return;
            }

            DialogResult respuesta = MessageBox.Show(
                "¿Estás seguro de eliminar este producto?",
                "Confirmar eliminación",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Warning);

            if (respuesta != DialogResult.Yes)
                return;

            int id = Convert.ToInt32(
                tabla.CurrentRow.Cells["Id"].Value);

            using (var conn = new SqliteConnection(conexion))
            {
                conn.Open();

                string sql =
                    "DELETE FROM Productos WHERE Id = $id;";

                using (var cmd = new SqliteCommand(sql, conn))
                {
                    cmd.Parameters.AddWithValue("$id", id);
                    cmd.ExecuteNonQuery();
                }
            }

            MessageBox.Show("Producto eliminado correctamente.");

            CargarProductos();
            LimpiarCampos(null, null);
        }

        // LIMPIAR CAMPOS
        private void LimpiarCampos(object sender, EventArgs e)
        {
            txtCodigo.Clear();
            txtNombre.Clear();
            numPrecio.Value = 0;
            numCantidad.Value = 0;

            tabla.ClearSelection();
        }
    }
}

// SISTEMA PARA LOGIARTE 
using System;
using System.Drawing;
using System.IO;
using System.Security.Cryptography;
using System.Windows.Forms;
using Microsoft.Data.Sqlite;

namespace sistema_de_inventario
{
    public class LoginForm : Form
    {
        private TextBox txtUsuario;
        private TextBox txtClave;

        private readonly string conexion =
            "Data Source=" + Path.Combine(
                AppDomain.CurrentDomain.BaseDirectory,
                "inventario.db");

        public string UsuarioAutenticado { get; private set; }
        public string RolAutenticado { get; private set; }

        public LoginForm()
        {
            CrearTablaUsuarios();
            CrearInterfaz();
        }

        private void CrearTablaUsuarios()
        {
            using (var conn = new SqliteConnection(conexion))
            {
                conn.Open();

                string sql = @"
            CREATE TABLE IF NOT EXISTS Usuarios (
                Id INTEGER PRIMARY KEY AUTOINCREMENT,
                Nombre TEXT NOT NULL DEFAULT '',
                Usuario TEXT NOT NULL UNIQUE,
                PasswordHash TEXT NOT NULL,
                Salt TEXT NOT NULL,
                Rol TEXT NOT NULL,
                Turno TEXT NOT NULL DEFAULT ''
            );";

                using (var cmd = new SqliteCommand(sql, conn))
                {
                    cmd.ExecuteNonQuery();
                }
                using (var cmd = new SqliteCommand("PRAGMA table_info(Usuarios);", conn))
                using (var reader = cmd.ExecuteReader())
                {
                    bool existeNombre = false;
                    bool existeTurno = false;

                    while (reader.Read())
                    {
                        string columna = reader["name"].ToString();

                        if (columna == "Nombre")
                            existeNombre = true;

                        if (columna == "Turno")
                            existeTurno = true;
                    }

                    reader.Close();

                    if (!existeNombre)
                    {
                        using (var cmdAlter = new SqliteCommand(
                            "ALTER TABLE Usuarios ADD COLUMN Nombre TEXT NOT NULL DEFAULT '';", conn))
                        {
                            cmdAlter.ExecuteNonQuery();
                        }
                    }

                    if (!existeTurno)
                    {
                        using (var cmdAlter = new SqliteCommand(
                            "ALTER TABLE Usuarios ADD COLUMN Turno TEXT NOT NULL DEFAULT '';", conn))
                        {
                            cmdAlter.ExecuteNonQuery();
                        }
                    }
                }
                using (var cmd = new SqliteCommand(
                    "SELECT COUNT(*) FROM Usuarios;", conn))
                {
                    long cantidad = (long)cmd.ExecuteScalar();

                    if (cantidad == 0)
                    {
                        string salt = Convert.ToBase64String(
                            RandomNumberGenerator.GetBytes(16));

                        string hash = GenerarHash("Admin123!", salt);

                        string insertar = @"
                    INSERT INTO Usuarios
                    (Usuario, PasswordHash, Salt, Rol)
                    VALUES
                    ('admin', $hash, $salt, 'Administrador');";

                        using (var comando = new SqliteCommand(insertar, conn))
                        {
                            comando.Parameters.AddWithValue("$hash", hash);
                            comando.Parameters.AddWithValue("$salt", salt);

                            comando.ExecuteNonQuery();
                        }
                    }
                }
            }
        }

        private string GenerarHash(string clave, string salt)
        {
            byte[] resultado = Rfc2898DeriveBytes.Pbkdf2(
                clave,
                Convert.FromBase64String(salt),
                100000,
                HashAlgorithmName.SHA256,
                32);

            return Convert.ToBase64String(resultado);
        }

        private void CrearInterfaz()
        {
            Text = "Inicio de sesión";
            Size = new Size(430, 390);
            StartPosition = FormStartPosition.CenterScreen;
            BackColor = Color.FromArgb(240, 243, 247);
            FormBorderStyle = FormBorderStyle.FixedDialog;
            MaximizeBox = false;

            Label titulo = new Label();
            titulo.Text = "SISTEMA DE INVENTARIO";
            titulo.Font = new Font("Arial", 17, FontStyle.Bold);
            titulo.Location = new Point(35, 35);
            titulo.Size = new Size(350, 35);
            titulo.TextAlign = ContentAlignment.MiddleCenter;
            Controls.Add(titulo);

            Label usuario = new Label();
            usuario.Text = "Usuario:";
            usuario.Location = new Point(55, 110);
            usuario.Size = new Size(300, 25);
            Controls.Add(usuario);

            txtUsuario = new TextBox();
            txtUsuario.Location = new Point(55, 138);
            txtUsuario.Size = new Size(300, 30);
            Controls.Add(txtUsuario);

            Label clave = new Label();
            clave.Text = "Contraseña:";
            clave.Location = new Point(55, 185);
            clave.Size = new Size(300, 25);
            Controls.Add(clave);

            txtClave = new TextBox();
            txtClave.Location = new Point(55, 213);
            txtClave.Size = new Size(300, 30);
            txtClave.UseSystemPasswordChar = true;
            Controls.Add(txtClave);

            Button btnEntrar = new Button();
            btnEntrar.Text = "INICIAR SESIÓN";
            btnEntrar.Location = new Point(55, 275);
            btnEntrar.Size = new Size(300, 45);
            btnEntrar.BackColor = Color.RoyalBlue;
            btnEntrar.ForeColor = Color.White;
            btnEntrar.FlatStyle = FlatStyle.Flat;
            btnEntrar.Click += IniciarSesion;
            Controls.Add(btnEntrar);

            AcceptButton = btnEntrar;
        }

        private void IniciarSesion(object sender, EventArgs e)
        {
            try
            {
                using (var conn = new SqliteConnection(conexion))
                {
                    conn.Open();

                    string sql = @"
                        SELECT PasswordHash, Salt, Rol
                        FROM Usuarios
                        WHERE Usuario = $usuario;";

                    using (var cmd = new SqliteCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue(
                            "$usuario", txtUsuario.Text.Trim());

                        using (var reader = cmd.ExecuteReader())
                        {
                            if (!reader.Read())
                            {
                                MessageBox.Show("Usuario incorrecto.");
                                return;
                            }

                            string hashGuardado = reader.GetString(0);
                            string salt = reader.GetString(1);
                            string rol = reader.GetString(2);

                            string hashIngresado =
                                GenerarHash(txtClave.Text, salt);

                            bool correcto =
                                CryptographicOperations.FixedTimeEquals(
                                    Convert.FromBase64String(hashGuardado),
                                    Convert.FromBase64String(hashIngresado));
                            if (correcto)
                            {
                                RolAutenticado = rol;

                                DialogResult = DialogResult.OK;
                                Close();
                            }
                            else
                            {
                                MessageBox.Show(
                                    "Contraseña incorrecta.");
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Error al iniciar sesión:\n" + ex.Message);
            }
        }
    }
}
